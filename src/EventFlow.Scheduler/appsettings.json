{
  "Database": {
    "Path": "data/eventflow-portfolio.db"
  },
  "Hangfire": {
    "Path": "data/eventflow-hangfire.db"
  },
  "RabbitMq": {
    "Enabled": true,
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "eventflow",
    "Password": "eventflow-local",
    "MainExchange": "eventflow.jobs",
    "RetryExchange": "eventflow.jobs.retry",
    "DeadExchange": "eventflow.jobs.dead",
    "RetryDelayMilliseconds": 10000,
    "MaxAttempts": 3,
    "PrefetchCount": 4
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Hangfire": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Urls": "http://localhost:5081"
}
